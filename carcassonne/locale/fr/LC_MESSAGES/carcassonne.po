msgstr "Commande inconnue. Tapez 'help' pour voir la liste des commandes."

msgid "New game started."
msgstr "Nouvelle partie commencée."

msgid "Available commands:"
msgstr "Commandes disponibles :"

msgid "  new <args>         - Start a new game"
msgstr "  new <args>         - Démarre une nouvelle partie"

msgid "  help               - Display this help message"
msgstr "  help               - Affiche cette aide"

msgid "  quit               - Quit the game"
msgstr "  quit               - Quitte le jeu"

msgid "  load <file>        - Load a game from a file"
msgstr "  load <file>        - Charge une partie depuis un fichier"

msgid "  save <file>        - Save the game to a file"
msgstr "  save <file>        - Sauvegarde la partie dans un fichier"

msgid "  shuffle            - Shuffle the deck"
msgstr "  shuffle            - Mélange la pioche"

msgid "  draw               - Draw a tile"
msgstr "  draw               - Pioche une tuile"

msgid "  hint               - Show a hint for the current tile"
msgstr "  hint               - Donne un indice pour la tuile actuelle"

msgid "  undo [N]           - Undo the last move or the last N moves"
msgstr "  undo [N]           - Annule le dernier coup ou les N derniers coups"

msgid "  redo [N]           - Redo the last undone move or the last N undone moves"
msgstr "  redo [N]           - Rétablit le dernier coup annulé ou les N derniers coups annulés"

msgid "  show hand          - Display the current player's hand"
msgstr "  show hand          - Affiche la main du joueur courant"

msgid "  show time [ID]     - Display the remaining time of all players or of player ID"
msgstr "  show time [ID]     - Affiche le temps restant de tous les joueurs ou du joueur ID"

msgid "  show score         - Display the players' scores"
msgstr "  show score         - Affiche le score des joueurs"

msgid "  show history       - Display the move history"
msgstr "  show history       - Affiche l'historique des coups"

msgid "  show configuration - Display the current game configuration"
msgstr "  show configuration - Affiche la configuration actuelle du jeu"

msgid "  set (PARAM=VALUE)  - Set a configuration parameter"
msgstr "  set (PARAM=VALUE)  - Définit un paramètre de configuration"

msgid "  play <move>        - Play the specified move"
msgstr "  play <move>        - Joue le coup indiqué"

msgid "  server start [PORT] - Start the server on port [PORT]"
msgstr "  server start [PORT] - Lance le serveur sur le port [PORT]"

msgid "  server list        - Display the list of available servers"
msgstr "  server list        - Affiche la liste des serveurs disponibles"

msgid "  server stop        - Stop the server"
msgstr "  server stop        - Arrête le serveur"

msgid "  join [IP[:PORT]]   - Connect the client to the given server or to its own server"
msgstr "  join [IP[:PORT]]   - Connecte le client au serveur indiqué ou à son propre serveur"

msgid "  quit               - Quit the server"
msgstr "  quit               - Quitte le serveur"

msgid "  ping               - Display the server ping"
msgstr "  ping               - Affiche le ping du serveur"

msgid "  server status      - Display the server status"
msgstr "  server status      - Affiche l'état du serveur"

msgid "  players [PLAYER_ID] - Display connected players or information about player [PLAYER_ID]"
msgstr "  players [PLAYER_ID] - Affiche les joueurs connectés ou les informations sur le joueur [PLAYER_ID]"

msgid "  scoreboard         - Display the server scoreboard"
msgstr "  scoreboard         - Affiche le classement du serveur"

msgid "  new PLAYER_ID ..   - Start a game with the proposed players"
msgstr "  new PLAYER_ID ..   - Commence une partie avec les joueurs proposés"

msgid "  accept             - Accept the received invitation"
msgstr "  accept             - Accepte l'invitation reçue"

msgid "  decline            - Decline the received invitation"
msgstr "  decline            - Refuse l'invitation reçue"

msgid "  cancel             - Cancel the sent invitation"
msgstr "  cancel             - Annule l'invitation envoyée"

msgid "  away               - Change the status to \"away\""
msgstr "  away               - Passe le statut à \"away\""

msgid "  back               - Change the status to \"idle\""
msgstr "  back               - Passe le statut à \"idle\""

