\begin{Verbatim}[commandchars=\\\{\}]
fonction minimax(etat, profondeur, joueur\PYGZus{}max):
    SI profondeur = 0 OU estFeuille(etat) ALORS
        RETOURNER evalueHeuristique(joueur\PYGZus{}max, etat)
    FIN SI
    SI joueur\PYGZus{}max ALORS
        valeur = \PYGZhy{}infini
        POUR TOUT successeur s de etat FAIRE
            valeur = max(valeur, minimax(s, profondeur \PYGZhy{} 1, FAUX))
        FIN POUR TOUT
    FIN SI
    SINON
        valeur = +infini
        POUR TOUT successeur s de etat FAIRE
            valeur = min(valeur, minimax(s, profondeur \PYGZhy{} 1, VRAI))
        FIN POUR TOUT
    FIN SINON
    RETOURNER valeur
FIN FONCTION

\end{Verbatim}
